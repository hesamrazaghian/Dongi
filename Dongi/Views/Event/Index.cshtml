@model List<Dongi.ViewModels.MyEventListItemViewModel>

@{
    ViewData ["Title"] = "My Events";
}

<h2>My Events</h2>

@if( !Model.Any( ) )
{
    <p>You have not created or joined any events yet.</p>
}
else
{
    <ul class="list-group">
        @foreach( var ev in Model )
        {
            <li class="list-group-item">
                <a asp-controller="Event"
                   asp-action="Details"
                   asp-route-id="@ev.Id">
                    @ev.Title
                </a>
            </li>
        }
    </ul>
}
