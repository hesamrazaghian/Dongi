@model Dongi.ViewModels.EventDetailsViewModel

@{
    ViewData ["Title"] = "Event Details";
}

<h2 class="mb-1">@Model.Title</h2>

<p class="text-muted">
    Event ID: @Model.Id
</p>

<hr />

<a asp-controller="Expense"
   asp-action="Create"
   asp-route-eventId="@Model.Id"
   class="btn btn-success mb-3">
    Add Expense
</a>

<hr />

<p class="text-muted">
    Expenses will be shown here.
</p>
