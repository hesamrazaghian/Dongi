@model Dongi.ViewModels.CreateExpenseViewModel

<h2>Add Expense</h2>

<form asp-action="Create" method="post">
    <input type="hidden" asp-for="EventId" />

    <div class="mb-3">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Amount"></label>
        <input asp-for="Amount" class="form-control" />
    </div>

    <h5>Participants</h5>

    @for( int i = 0; i < Model.Participants.Count; i++ )
    {
        <div class="form-check">
            <input asp-for="Participants [i].IsSelected" class="form-check-input" />
            <label class="form-check-label">
                @Model.Participants [i].DisplayName
            </label>
            <input type="hidden" asp-for="Participants [i].PersonId" />
            <input type="hidden" asp-for="Participants [i].DisplayName" />
        </div>
    }

    <button type="submit" class="btn btn-primary mt-3">Save</button>
</form>
